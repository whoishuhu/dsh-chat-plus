{
  "name": "dsh-chat-plus",
  "version": "0.2.8",
  "description": "对话增强：同会话回复重生成、多版本切换、消息编辑删除、回退与会话回收站。",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "lib", "test", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.zh.md", "README.ja.md", "README.es.md", "README.fr.md", "README.de.md", "README.ru.md", "README.pt.md", "ARCHITECTURE.md", "index.html", ".github/workflows/pages.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  }
}
